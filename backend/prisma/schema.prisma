// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum UserSkillType {
  TEACH
  LEARN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum RoadmapStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MilestoneStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum CommitmentStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum CheckInStatus {
  COMPLETED
  PARTIAL
  STUCK
  SKIPPED
}

enum FocusSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum PartnershipStatus {
  PENDING
  ACCEPTED
  REJECTED
  ENDED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum AudioCallMode {
  NORMAL
  AI_TOPIC_EXCHANGE
}

enum AudioSessionStatus {
  WAITING
  PREPARING
  USER_A_TURN
  USER_B_TURN
  COMPLETED
  CANCELLED
  REJECTED
}

enum ReportReason {
  INAPPROPRIATE_BEHAVIOR
  SPAM
  HARASSMENT
  SCAM
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ReportActionTaken {
  NONE
  WARNED
  BANNED
  DELETED
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  username        String?   @unique
  bio             String?   @db.Text
  avatarUrl       String?
  latitude        Float?
  longitude       Float?
  locationEnabled Boolean   @default(false)
  role            UserRole  @default(USER)
  country         String?
  isBanned        Boolean   @default(false)
  bannedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userSkills         UserSkill[]
  learningGoals      LearningGoal[]
  weeklyCommitments  WeeklyCommitment[]
  checkIns           CheckIn[]
  focusSessions      FocusSession[]

  partnershipsRequested Partnership[]       @relation("Requester")
  partnershipsReceived  Partnership[]       @relation("Recipient")
  projectContributions  ProjectContributor[]
  reviewsGiven          PartnershipReview[] @relation("Reviewer")
  reviewsReceived       PartnershipReview[] @relation("Reviewee")
  reportsSent           UserReport[]        @relation("Reporter")
  reportsReceived       UserReport[]        @relation("ReportedUser")
  partnershipTopics     PartnershipTopic[]
}

model SkillCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  skills Skill[]
}

model Skill {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())

  category      SkillCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  userSkills    UserSkill[]
  learningGoals LearningGoal[]
}

model UserSkill {
  id        String        @id @default(uuid())
  userId    String
  skillId   String
  type      UserSkillType
  level     SkillLevel
  createdAt DateTime      @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, type])
}

model LearningGoal {
  id            String     @id @default(uuid())
  userId        String
  skillId       String
  title         String
  description   String?    @db.Text
  targetOutcome String?    @db.Text
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill    Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  roadmaps Roadmap[]
}

model Roadmap {
  id          String        @id @default(uuid())
  goalId      String
  title       String
  description String?       @db.Text
  status      RoadmapStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  goal       LearningGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestones Milestone[]
}

model Milestone {
  id          String          @id @default(uuid())
  roadmapId   String
  title       String
  description String?         @db.Text
  order       Int
  status      MilestoneStatus @default(TODO)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  roadmap           Roadmap            @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  weeklyCommitments WeeklyCommitment[]
  checkIns          CheckIn[]
  focusSessions     FocusSession[]
}

model WeeklyCommitment {
  id          String           @id @default(uuid())
  userId      String
  milestoneId String
  title       String
  weekStart   DateTime
  weekEnd     DateTime
  status      CommitmentStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  checkIns  CheckIn[]
}

model CheckIn {
  id           String        @id @default(uuid())
  userId       String
  milestoneId  String
  commitmentId String?
  status       CheckInStatus
  note         String?       @db.Text
  createdAt    DateTime      @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone  Milestone         @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  commitment WeeklyCommitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
}

model FocusSession {
  id          String             @id @default(uuid())
  userId      String
  milestoneId String?
  startedAt   DateTime
  completedAt DateTime?
  duration    Int?
  status      FocusSessionStatus @default(IN_PROGRESS)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
}

model Partnership {
  id          String            @id @default(uuid())
  requesterId String
  recipientId String
  status      PartnershipStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  acceptedAt  DateTime?
  updatedAt   DateTime          @updatedAt

  requester User                     @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User                     @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  projects      Project[]
  reviews       PartnershipReview[]
  messages      PartnershipMessage[]
  audioSessions PartnershipAudioSession[]
  reports       UserReport[]
  topics        PartnershipTopic[]

  @@unique([requesterId, recipientId])
}

model PartnershipMessage {
  id            String    @id @default(uuid())
  partnershipId String
  senderId      String?
  senderType    String    @default("USER")
  senderName    String?
  content       String    @db.Text
  replyToId     String?
  isRead        Boolean   @default(false)
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  partnership Partnership         @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  replyTo     PartnershipMessage? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     PartnershipMessage[] @relation("MessageReplies")
}

model Project {
  id            String        @id @default(uuid())
  partnershipId String
  title         String
  description   String?       @db.Text
  status        ProjectStatus @default(PLANNING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  partnership  Partnership          @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  contributors ProjectContributor[]
}

model ProjectContributor {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model PartnershipReview {
  id               String   @id @default(uuid())
  partnershipId    String
  reviewerId       String
  revieweeId       String
  consistency      Int
  communication    Int
  knowledgeSharing Int
  collaboration    Int
  comment          String?  @db.Text
  createdAt        DateTime @default(now())

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee    User        @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([partnershipId, reviewerId, revieweeId])
}

model PartnershipAudioSession {
  id               String             @id @default(uuid())
  partnershipId    String
  mode             AudioCallMode
  status           AudioSessionStatus @default(WAITING)
  requesterId      String
  recipientId      String
  firstSpeakerId   String?
  secondSpeakerId  String?
  currentSpeakerId String?
  userATopic       String?
  userBTopic       String?
  userATopicStatus String?
  userBTopicStatus String?
  turnStartedAt    DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
}

model UserReport {
  id            String            @id @default(uuid())
  reporterId    String
  reportedId    String
  partnershipId String?
  reason        ReportReason
  description   String?           @db.Text
  status        ReportStatus      @default(PENDING)
  actionTaken   ReportActionTaken @default(NONE)
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  reporter    User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported    User         @relation("ReportedUser", fields: [reportedId], references: [id], onDelete: Cascade)
  partnership Partnership? @relation(fields: [partnershipId], references: [id], onDelete: SetNull)
}

model PartnershipTopic {
  id            String    @id @default(uuid())
  partnershipId String
  targetUserId  String
  title         String
  description   String?   @db.Text
  category      String?
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  order         Int       @default(0)
  isAiGenerated Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  partnership Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  targetUser  User        @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
}


